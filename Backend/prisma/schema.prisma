// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// "Generate a JavaScript client so my Node.js app can use the database."
generator client {
  provider = "prisma-client-js"
}

// This tells Prisma: We are using PostgreSQL. The connection string comes from .env.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Model
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("MEMBER")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Added for Borrowing relationship
  borrowings Borrowing[]
}

// Author Model
model Author {
  id        Int      @id @default(autoincrement())
  name      String
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books Book[]
}

// Category Model
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books Book[]
}

// Book Model
model Book {
  id            Int      @id @default(autoincrement())
  title         String
  isbn          String   @unique
  publishedYear Int?
  totalCopies   Int      @default(1)
  available     Int      @default(1)

  authorId      Int
  categoryId    Int

  author        Author   @relation(fields: [authorId], references: [id])
  category      Category @relation(fields: [categoryId], references: [id])

  // Added for Borrowing relationship
  borrowings    Borrowing[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Borrowing Status Enum
enum BorrowingStatus {
  BORROWED
  RETURNED
  OVERDUE
}

// Borrowing Model
model Borrowing {
  id         Int      @id @default(autoincrement())

  userId     Int
  bookId     Int

  borrowedAt DateTime @default(now())
  dueDate    DateTime
  returnedAt DateTime?

  status     BorrowingStatus    @default(BORROWED)

  user       User     @relation(fields: [userId], references: [id])
  book       Book     @relation(fields: [bookId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}